# Set one of these. If both are set, GROQ_API_KEY wins unless LLM_PROVIDER
# says otherwise. See app/llm.py for provider resolution.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: force a provider instead of relying on which key is present.
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=groq

# Optional: override the default model for whichever provider is active
# (claude-sonnet-5 for anthropic, llama-3.3-70b-versatile for groq).
# EVIDENCE_ENGINE_MODEL=
